# Copy to .env.production and keep the filled file outside version control.
# Values below are placeholders, not working credentials.

POSTGRES_DB=porcupine_directory
POSTGRES_USER=porcupine_admin
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
APP_DB_PASSWORD=replace-with-a-different-runtime-database-password

# The one-shot migration container uses the owner connection. The app uses the
# restricted runtime connection after migrations finish.
# URL-encode reserved characters in the password.
ADMIN_DATABASE_URL=postgres://porcupine_admin:replace-with-a-long-random-database-password@db:5432/porcupine_directory
APP_DATABASE_URL=postgres://porcupine_app:replace-with-a-different-runtime-database-password@db:5432/porcupine_directory
COMPOSE_DATABASE_URL=postgres://porcupine_app:replace-with-a-different-runtime-database-password@db:5432/porcupine_directory

APP_ORIGIN=https://porcupinedirectory.com
APP_HOST_PORT=4350
# Public IPv4 address for Caddy. Keep private/Tailscale listeners separate.
PUBLIC_BIND_ADDRESS=187.77.2.189
SESSION_SECRET=replace-with-at-least-32-random-characters
STAFF_AUTH_MODE=session
# Caddy is the single trusted reverse proxy in the production Compose stack.
TRUST_PROXY=1
SUBMISSION_POLICY=published
PASSKEYS_ENABLED=false

FSP_SYNC_ENABLED=true
PUBLICATION_SYNC_ENABLED=true

# Leave blank to keep email recovery disabled. If enabled, use a real TLS SMTP provider.
SMTP_HOST=
SMTP_MODE=smtp
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_ENCRYPTION_KEY=

DONATION_BITCOIN_ADDRESS=
DONATION_LIGHTNING_ADDRESS=
