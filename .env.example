PORT=3000
# Runtime environment used to keep service tokens separated between local,
# staging and production. Use development for local preview.
APP_ENVIRONMENT=development

# Required local-only database settings. Choose a password and keep production
# values out of this file.
POSTGRES_DB=porcupine_directory
POSTGRES_USER=porcupine
POSTGRES_PASSWORD=
# Used by a locally run server and host-side integration tests.
DATABASE_URL=
TEST_DATABASE_URL=
# Used by the app container to reach the Compose database service.
COMPOSE_DATABASE_URL=
# Canonical browser origin (including port in development). Passkeys bind to its hostname.
APP_ORIGIN=http://localhost:4350
# Required for public HTTPS deployment: generate 48 random bytes (base64url).
# If blank on localhost, restarts sign everyone out. Never commit the actual value.
SESSION_SECRET=
SUBMISSION_POLICY=published
# Deferred to v0.2. UI availability does not choose staff policy.
PASSKEYS_ENABLED=false
# Approved v0.1 policy: active staff sessions; no periodic password re-entry.
# Use passkey for the preserved future policy. Unknown values fail closed to passkey.
STAFF_AUTH_MODE=session
# Only enable behind exactly one trusted reverse proxy; keep the app port private.
TRUST_PROXY=0
# Optional verified-email recovery. Blank means disabled; use this project's own mail service.
SMTP_HOST=
SMTP_MODE=smtp
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Separate 32-byte encryption key encoded as 64 hex characters. Back it up securely.
EMAIL_ENCRYPTION_KEY=
# Poll FSP hourly while the app is running. Set false for isolated/offline development.
FSP_SYNC_ENABLED=true
# Reviewed publisher feed only, hourly. No visitor-side third-party requests.
PUBLICATION_SYNC_ENABLED=true
# Public receiving destinations ONLY. Never enter seed phrases or private keys.
# Bitcoin mainnet address; checksum verified. Blank/invalid disables that method.
DONATION_BITCOIN_ADDRESS=
# Lightning Address in name@provider.example format (not an email inbox).
# Confirm provider support and ownership before configuring. No Nostr zap receipts.
DONATION_LIGHTNING_ADDRESS=
# Optional self-hosted LNURL-pay backend. Configure all three LND values to
# serve DONATION_LIGHTNING_ADDRESS from this application. Prefer the restricted
# Alby Hub NWC connection below; otherwise use all three LND values. Never
# expose LND RPC publicly.
DONATION_LIGHTNING_NWC_URL=
DONATION_LIGHTNING_LND_REST_URL=
DONATION_LIGHTNING_LND_MACAROON_HEX=
DONATION_LIGHTNING_LND_TLS_CERT_B64=
DONATION_LIGHTNING_MIN_MSAT=
DONATION_LIGHTNING_MAX_MSAT=
DONATION_LIGHTNING_EXPIRY_SECONDS=
DONATION_LIGHTNING_MEMO=
